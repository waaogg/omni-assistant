[Unit]
Description=Omni-Assistant (QQ & WeChat Multi-Channel Personal AI Daemon)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/omni-assistant
ExecStart=/usr/bin/python3 /opt/omni-assistant/main.py
Restart=always
RestartSec=5s
EnvironmentFile=-/opt/omni-assistant/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
