# ==============================================================================
# Omni-Assistant (全渠道个人智能助理) - 环境变量配置模板
# 使用说明：复制本文件为 .env 并填入实际业务配置，未启用的通道无需配置
# ==============================================================================

# ========================== 1. 通道开关 (Channel Toggles) ==========================
# 是否启用 QQ 机器人通道 (true / false)
# 若设为 false 或未配置，系统不会加载 QQ 模块，不探测 NapCat 连接，不强制依赖 QQ 环境
ENABLE_QQ=false

# 是否启用 微信 机器人通道 (true / false)
# 若设为 false 或未配置，系统不会加载微信模块，不发起微信网关轮询，不弹出登录二维码
ENABLE_WECHAT=false


# ======================== 2. AI 大模型驱动配置 (AI Provider) ========================
# AI_PROVIDER=openai 使用 HTTP；也可选 agy/codex/opencode/claude CLI
AI_PROVIDER=openai

# CLI 缺失时是否自动从官方 npm 包安装（agy 需另行配置 AGY_INSTALL_COMMAND）
AUTO_INSTALL_CLI=false

# 大模型服务 Base URL (兼容任何标准 OpenAI 格式，如 DeepSeek、OpenAI、Moonshot、Qwen、Ollama、vLLM)
LLM_BASE_URL=https://api.deepseek.com/v1

# 大模型 API Key 凭证
LLM_API_KEY=sk-your-deepseek-or-openai-api-key-here

# 推理模型标识符 (如 deepseek-chat, deepseek-reasoner, gpt-4o-mini, gemini-2.5-flash)
LLM_MODEL=deepseek-chat

# 大模型采样温度 (0.0 ~ 1.0，推荐 0.1 保持逻辑与工具调用稳定)
LLM_TEMPERATURE=0.1

# 可选 CLI 路径/自定义参数；{prompt} 会被替换为本轮提示
CODEX_BIN_PATH=codex
CODEX_ARGS=exec --json "{prompt}"
OPENCODE_BIN_PATH=opencode
OPENCODE_ARGS=run --format json "{prompt}"
CLAUDE_BIN_PATH=claude
CLAUDE_ARGS=-p "{prompt}" --output-format json
AGY_BIN_PATH=agy
AGY_ARGS=-p "{prompt}" --output-format json
AGY_INSTALL_COMMAND=

# Python executable used by the WeChat-to-core bridge.
PYTHON_BIN_PATH=python3

# ====================== 3. QQ 机器人通道配置 (ENABLE_QQ=true 时生效) ======================
# 管理员 QQ 账号（机器人只向此账号汇报通知，并响应其私聊指令）
ADMIN_QQ=10000001

# 目标监听群号（支持半角逗号分隔多个群号，如 90000001,90000002）
# 机器人在此群内静默监听通知，提取日程并私聊汇报给管理员，绝不主动在群内发言
TARGET_GROUP_IDS=90000001

# NapCat OneBot v11 HTTP 接口地址
NAPCAT_HTTP_URL=http://127.0.0.1:3000

# NapCat OneBot v11 WebSocket 事件流地址
NAPCAT_WS_URL=ws://127.0.0.1:3001

# NapCat 通信访问密钥 (Access Token，若 NapCat 未开启鉴权可留空)
NAPCAT_TOKEN=your_napcat_access_token_here


# ===================== 4. 微信机器人通道配置 (ENABLE_WECHAT=true 时生效) =====================
# 腾讯官方 iLink 机器人网关地址 (无需修改)
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com

# 微信会话与登录凭据存储目录 (默认为项目内 data/wechat)
WECHAT_DATA_DIR=./data/wechat


# ===================== 5. Microsoft To Do 日程同步与闹钟规范 =====================
# 是否启用微软 To Do 待办同步联动 (true / false)
ENABLE_MS_TODO=false

# 默认待办清单 List ID (留空则自动同步至默认"任务"清单)
MS_TODO_DEFAULT_LIST_ID=

# Microsoft To Do MCP 模块路径 (若使用 Node SDK 或全局 npm 安装)
MS_TODO_AUTH_MODULE_PATH=/usr/lib/node_modules/@mag-cie/mcp-microsoft-todo/dist/auth.js

# 默认提前闹钟分钟数 (当通知未显式指定提前量时，默认提前 15 分钟触发原生系统闹钟)
DEFAULT_REMINDER_ADVANCE_MINUTES=15


# =========================== 6. 本地数据持久化与日志 ===========================
# 群历史发言本地缓存文件路径
HISTORY_FILE_PATH=./data/group_history.json

# 已同步待办哈希指纹与语义记忆库路径 (实现跨通道防重与增量更新)
MEMORY_FILE_PATH=./data/synced_todos.json

# SQLite is the authoritative v2 state store. Legacy JSON files can be imported.
DATABASE_FILE_PATH=./data/omni.db

# Unclear notices enter the confirmation inbox instead of being auto-applied.
AUTO_APPLY_CONFIDENCE=0.92
MESSAGE_BATCH_WINDOW_SECONDS=20
MAX_MESSAGE_ATTEMPTS=5

# Optional comma-separated allowlist. When omitted, WeChat uses the bound user ID.
ALLOWED_WECHAT_USER_IDS=
REQUIRE_CONFIRMATION_FOR_DELETE=true
DAILY_DIGEST_TIME=08:00
WEEKLY_REVIEW_DAY=0
QUIET_HOURS=22:00-07:00

# 日志输出等级 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO


# =========================== 7. 图形化设置面板 ===========================
# 启动 python dashboard.py 后访问此地址；默认只监听本机
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# 可选：设置后，客户端需发送 X-Dashboard-Token 请求头
DASHBOARD_TOKEN=
